---
import '../styles/global.css';
import journey from '../data/journey.json';
import social from '../data/social.json';
import SocialPost from '../components/SocialPost.astro';
const modules = import.meta.glob('../data/days/*.json', { eager: true, import: 'default' });
type Meal = { name: string; description: string; calories?: number; protein?: number; carbs?: number; fat?: number };
type Day = { date: string; status: string; weightKg: number | null; meals: Meal[]; training: { name: string; description: string; calories?: string }[]; reflection: string; media: { src: string; alt: string }[] };
const days = Object.values(modules).map(d => d as Day).sort((a,b) => b.date.localeCompare(a.date));
const latest = days.find(d => d.weightKg !== null);
const lost = latest ? journey.startWeightKg - latest.weightKg! : 0;
const target = journey.startWeightKg - journey.targetLossKg;
const progress = Math.max(0, Math.min(100, lost / journey.targetLossKg * 100));
const dateLabel = (date: string) => new Date(`${date}T12:00:00Z`).toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' });
const posts = social.posts as { platform: 'youtube' | 'instagram'; url: string; title: string }[];
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="A twenty-week fitness transformation, documented through daily food, training, yoga, and honest progress."/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>Saptyogi | {journey.title}</title></head>
<body>
<header class="site-header"><a class="brand" href="/" aria-label="Transformation journal home"><span class="brand-icon">↗</span> SAPTYOGI</a><nav aria-label="Main navigation"><a href="#progress">Progress</a><a href="#journal">Journal</a><a href="#watch">Watch</a><button class="theme-shuffle" id="theme-shuffle" type="button" aria-label="Switch between light and dark mode">◐</button></nav></header>
<main>
<section class="hero"><div><p class="eyebrow"><span class="dot"></span> 20 WEEKS · ONE DAY AT A TIME</p><h1>A little stronger.<br/>Every <em>single day.</em></h1><p class="intro">A personal fitness transformation, documented as it happens. The food, the training, the practice — and the progress in between.</p><a class="button" href="#journal">Follow the journey <span>↘</span></a></div><aside class="goal-card"><p class="eyebrow">THE COMMITMENT</p><div class="goal-number">21<span>kg</span></div><p>Target weight loss over 20 weeks</p><div class="rule"></div><div class="goal-dates"><div><small>STARTED</small><strong>26 Oct 2026</strong></div><div><small>FINISH LINE</small><strong>14 Mar 2027</strong></div></div><p class="card-note">Food. Movement. Consistency.</p></aside></section>
<section id="progress" class="section"><div class="section-heading"><div><p class="eyebrow">THE BIG PICTURE</p><h2>Progress, in perspective.</h2></div><p>Every measurement is part of the story.</p></div><div class="metrics"><article><span>Starting weight</span><strong>{journey.startWeightKg.toFixed(2)}<small> kg</small></strong><p>{dateLabel(journey.startDate)}</p></article><article><span>Latest weight</span><strong>{latest?.weightKg?.toFixed(2) ?? '—'}<small> kg</small></strong><p>{latest ? dateLabel(latest.date) : 'Awaiting a measurement'}</p></article><article><span>Weight lost</span><strong>{lost.toFixed(2)}<small> kg</small></strong><p>Of a {journey.targetLossKg} kg target</p></article><article><span>Target weight</span><strong>{target.toFixed(2)}<small> kg</small></strong><p>By {dateLabel(journey.endDate)}</p></article></div><div class="progress-panel"><div><h3>The journey so far</h3><span>{progress.toFixed(1)}% of weight-loss target</span></div><progress value={progress} max="100">{progress}%</progress><div class="scale"><span>{journey.startWeightKg.toFixed(2)} kg · Start</span><span>{target.toFixed(2)} kg · Target</span></div><p class="muted">{days.filter(d=>d.weightKg!==null).length < 2 ? 'The first measurement is in. A weight trend will take shape as more measurements are logged.' : 'Recorded weigh-ins are listed in the daily journal below.'}</p></div></section>
<section id="journal" class="section"><div class="section-heading"><div><p class="eyebrow">THE EVERYDAY WORK</p><h2>The daily journal.</h2></div><span class="pill">{days.length} day{days.length===1?'':'s'} documented</span></div>{days.map((day,index)=><article class="journal-entry"><div class="entry-date"><span>DAY {Math.round((Date.parse(day.date)-Date.parse(journey.startDate))/86400000)+1}</span><h3>{dateLabel(day.date)}</h3><span class="status">{day.status==='in-progress'?'In progress':'Complete'}</span></div><div class="entry-content"><div class="entry-top"><h3>{day.date===journey.startDate?'The starting line.':'Showing up, again.'}</h3><span>{day.weightKg!==null?`${day.weightKg.toFixed(2)} kg`:'Weight not logged'}</span></div>{day.media?.length&&<div class="progress-photo"><a href={day.media[0].src} target="_blank" rel="noopener noreferrer"><img src={day.media[0].src} alt={day.media[0].alt} loading="lazy"/></a><span>Progress photo · Day {Math.round((Date.parse(day.date)-Date.parse(journey.startDate))/86400000)+1} · Click to view full size</span></div>}<div class="log-columns"><div><h4>01 / Food</h4>{day.meals.length?day.meals.map(meal=><div class="meal"><p><strong>{meal.name}</strong><br/>{meal.description}</p>{meal.calories!==undefined&&<div class="macro-line"><span>≈ {meal.calories} kcal</span><span>P {meal.protein}g</span><span>C {meal.carbs}g</span><span>F {meal.fat}g</span></div>}</div>):<p class="muted">Meals haven’t been logged yet.</p>} {day.meals.some(meal=>meal.calories!==undefined)&&<p class="estimate-note">Approximate estimates; recipes and portions can change the numbers.</p>}</div><div><h4>02 / Movement</h4>{day.training.length?<ul class="training-list">{day.training.map(session=><li><strong>{session.name}</strong><span>{session.description}</span>{session.calories&&<small>{session.calories}</small>}</li>)}</ul>:<p class="muted">Training hasn’t been logged yet.</p>}<p class="estimate-note">Calorie burn is a broad estimate and depends on pace, rest, and effort.</p></div></div>{day.reflection&&<p class="reflection">{day.reflection}</p>}</div></article>)}</section>
<section id="watch" class="section watch"><div class="section-heading"><div><p class="eyebrow">BEYOND THE NUMBERS</p><h2>The journey, on camera.</h2></div><p>Training clips, reflections, and moments along the way.</p></div>{posts.length?<div class="social-grid">{posts.map(post=><SocialPost {...post}/>)}</div>:<div class="social-empty"><span class="play-symbol">▷</span><div><h3>More of the journey, coming here.</h3><p>Selected YouTube videos and Instagram posts will appear here once the first links are added.</p></div></div>}{(social.instagramProfile||social.youtubeProfile)&&<div class="social-links">{social.instagramProfile&&<a href={social.instagramProfile} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}{social.youtubeProfile&&<a href={social.youtubeProfile} target="_blank" rel="noopener noreferrer">YouTube ↗</a>}</div>}</section>
</main><footer><a class="brand" href="/">SAPTYOGI</a><p>A personal journey. An honest record.</p><a href="#">Back to top ↑</a></footer>
{posts.some(p=>p.platform==='instagram')&&<script is:inline async src="https://www.instagram.com/embed.js"></script>}
<script is:inline>
  const themeButton = document.querySelector('#theme-shuffle');
  if (localStorage.getItem('saptyogi-theme') === 'dark') document.body.classList.add('dark-mode');
  themeButton?.addEventListener('click', () => {
    const dark = document.body.classList.toggle('dark-mode');
    localStorage.setItem('saptyogi-theme', dark ? 'dark' : 'light');
    themeButton.setAttribute('aria-pressed', String(dark));
  });
</script>
</body></html>
