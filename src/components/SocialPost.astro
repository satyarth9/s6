---
interface Props { platform: 'youtube' | 'instagram'; url: string; title: string; }
const { platform, url, title } = Astro.props;
const parsed = new URL(url);
let videoId: string | null = null;
if (platform === 'youtube') {
  if (parsed.hostname === 'youtu.be') videoId = parsed.pathname.split('/')[1];
  else if (['youtube.com', 'www.youtube.com', 'm.youtube.com'].includes(parsed.hostname)) {
    videoId = parsed.searchParams.get('v') || parsed.pathname.match(/^\/(?:shorts|embed)\/([^/]+)/)?.[1] || null;
  }
  if (videoId && !/^[\w-]{11}$/.test(videoId)) videoId = null;
}
const instagram = platform === 'instagram' && ['instagram.com', 'www.instagram.com'].includes(parsed.hostname) && /^\/(p|reel)\/[\w-]+\/?$/.test(parsed.pathname);
---
<article class="social-post">
  <p class="eyebrow">{platform}</p><h3>{title}</h3>
  {videoId && <iframe class="video" src={`https://www.youtube-nocookie.com/embed/${videoId}`} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>}
  {instagram && <blockquote class="instagram-media" data-instgrm-permalink={`https://www.instagram.com${parsed.pathname}`} data-instgrm-version="14"><a href={url} target="_blank" rel="noopener noreferrer">View this post on Instagram</a></blockquote>}
  <a href={url} target="_blank" rel="noopener noreferrer">Open on {platform === 'youtube' ? 'YouTube' : 'Instagram'} ↗</a>
</article>
